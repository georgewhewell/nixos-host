From 4b89e1efff2255120107679b915ee55fc8b7d861 Mon Sep 17 00:00:00 2001
From: nixos-config <noreply@localhost>
Date: Sun, 30 Aug 2026 00:00:00 +0200
Subject: [PATCH] nat44-ed: distribute new sessions by flow

NAT44-ED's in2out handoff sends every new session from one inside address to
the same worker. A single fast client therefore cannot use the other NAT
workers even when its flows have different ports and remote endpoints.

Keep the global flow-hash lookup as the authority for established sessions,
but select a worker for a genuinely new packet-created session from the full
ED key. Calls without a packet retain the source-address mapping used by
static-mapping control-plane placement.

Session deletion and original-destination lookup must use the worker recorded
in the global flow hash once sessions no longer have source-only ownership.
Likewise, user dumps and static/LB cleanup must inspect every per-thread pool.

diff --git a/plugins/nat/nat44-ed/nat44_ed.c b/plugins/nat/nat44-ed/nat44_ed.c
--- a/plugins/nat/nat44-ed/nat44_ed.c
+++ b/plugins/nat/nat44-ed/nat44_ed.c
@@ -788,8 +788,6 @@
       continue;
     nat44_ed_free_session_data (sm, s, tsm - sm->per_thread_data, 0);
     vec_add1 (indexes_to_free, s - tsm->sessions);
-    if (!addr_only)
-      break;
   }
   u32 *ses_index;
   vec_foreach (ses_index, indexes_to_free)
@@ -800,6 +798,39 @@
   vec_free (indexes_to_free);
 }
 
+static void
+nat_ed_lb_mapping_del_sessions (snat_main_t *sm, ip4_address_t l_addr,
+				u16 l_port, u32 fib_index)
+{
+  snat_main_per_thread_data_t *tsm;
+  snat_session_t *s;
+
+  vec_foreach (tsm, sm->per_thread_data)
+    {
+      u32 *indexes_to_free = NULL;
+
+      pool_foreach (s, tsm->sessions)
+	{
+	  if (!nat44_ed_is_lb_session (s) ||
+	      s->in2out.fib_index != fib_index ||
+	      s->in2out.addr.as_u32 != l_addr.as_u32 ||
+	      s->in2out.port != l_port)
+	    continue;
+
+	  nat44_ed_free_session_data (sm, s, tsm - sm->per_thread_data, 0);
+	  vec_add1 (indexes_to_free, s - tsm->sessions);
+	}
+
+      u32 *ses_index;
+      vec_foreach (ses_index, indexes_to_free)
+	{
+	  s = pool_elt_at_index (tsm->sessions, *ses_index);
+	  nat_ed_session_delete (sm, s, tsm - sm->per_thread_data, 1);
+	}
+      vec_free (indexes_to_free);
+    }
+}
