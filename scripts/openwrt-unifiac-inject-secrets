#!/usr/bin/env bash
# Inject wifi secrets into a freshly-flashed OpenWrt UniFi AC-Pro.
#
# The custom image (packages/openwrt-unifiac-pro) bakes the full wifi config
# with placeholder keys — secrets are never put in the nix store. This script
# pulls them from sops and applies them via uci, then reloads wifi.
#
# Run from a host with sops + gpg-agent access to secrets/wifi.yaml (e.g.
# fuckup), with the repo as CWD or as $0's parent.
#   Usage: scripts/openwrt-unifiac-inject-secrets [root@ap]   (default root@192.168.23.3)
set -euo pipefail

AP="${1:-root@192.168.23.3}"
cd "$(cd "$(dirname "$0")/.." && pwd)"

d() { nix run nixpkgs#sops -- -d --extract "[\"$1\"]" secrets/wifi.yaml 2>/dev/null | tr -d '\n'; }
RFE=$(d wifi-password)         # Radio Free Europe (WPA3-SAE)
VM=$(d wifi-password-backup)   # VM4588425 legacy (WPA2-PSK)
FT=$(d wifi-ft-key)            # 802.11r FT key-holder secret
[ -n "$RFE" ] && [ -n "$VM" ] && [ -n "$FT" ] || { echo "ERROR: sops decrypt failed" >&2; exit 1; }

printf '%s\n%s\n%s\n' "$RFE" "$VM" "$FT" | ssh -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10 "$AP" '
set -e
read RFE; read VM; read FT
uci set wireless.wifi5.key="$RFE"
uci set wireless.wifi2.key="$RFE"
uci set wireless.legacy5.key="$VM"
uci set wireless.legacy2.key="$VM"
for IF in wifi5 wifi2; do
  uci -q delete wireless.$IF.r0kh || true
  uci -q delete wireless.$IF.r1kh || true
  uci add_list wireless.$IF.r0kh="ff:ff:ff:ff:ff:ff,*,$FT"
  uci add_list wireless.$IF.r1kh="00:00:00:00:00:00,00:00:00:00:00:00,$FT"
done
uci commit wireless
wifi reload
sleep 6
echo "--- SSIDs broadcasting ---"
iwinfo 2>/dev/null | grep -E "ESSID|Channel"
'
