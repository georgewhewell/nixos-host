#!/usr/bin/env bash
set -euo pipefail

# The CRS812 owns 192.168.23.27 / mikrotik-400g now; the CRS804 renumbered to
# .28 (see machines/routeros/crs804/config.rsc). While the switch is still on
# its pre-move address the two collide, so reach it over its link-local
# instead: MIKROTIK_CRS804_HOST='fe80::d2ea:11ff:fed1:9d85%mlxlan0'. The
# host-key fingerprint check below is what stops a wrong-address run from
# applying the CRS804's desired state to the CRS812.
host="${MIKROTIK_CRS804_HOST:-192.168.23.28}"
user="${MIKROTIK_CRS804_USER:-admin}"
pass_entry="${MIKROTIK_CRS804_PASS_ENTRY:-mikrotik-400g.lan}"
expected_fingerprint="SHA256:hvAzlvmnyO7enVVMdUU+SO/XH9yms4YtaWSswgCuwjU"
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
config="${repo_root}/machines/routeros/crs804/config.rsc"
remote_config="crs804-nixos-config.rsc"

usage() {
  cat <<'EOF'
Usage: scripts/mikrotik-crs804-apply-config [--dry-run|--apply]

The password is read directly from `pass` and supplied to sshpass through its
environment; it is never printed or placed in a process argument.

Set MIKROTIK_CRS804_HOST to override the target, e.g. the switch's link-local
address while it is being renumbered off the contested 192.168.23.27.
EOF
}

mode="${1:---dry-run}"
case "${mode}" in
  --dry-run|--apply) ;;
  -h|--help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

for command in pass ssh ssh-keyscan ssh-keygen scp; do
  if ! command -v "${command}" >/dev/null 2>&1; then
    echo "Missing required command: ${command}" >&2
    exit 1
  fi
done

sshpass_bin="${SSHPASS_BIN:-$(command -v sshpass || true)}"
if [[ -z "${sshpass_bin}" ]]; then
  if ! command -v nix >/dev/null 2>&1; then
    echo "Missing required command: sshpass (and nix is unavailable to provide it)" >&2
    exit 1
  fi
  sshpass_bin="$(nix build --no-link --print-out-paths nixpkgs#sshpass)/bin/sshpass"
fi

known_hosts="$(mktemp --tmpdir="${repo_root}/.git" crs804-known-hosts.XXXXXX)"
trap 'rm -f "${known_hosts}"' EXIT
ssh-keyscan -T 5 "${host}" >"${known_hosts}" 2>/dev/null
actual_fingerprint="$(ssh-keygen -lf "${known_hosts}" -E sha256 | awk 'NR == 1 { print $2 }')"
if [[ "${actual_fingerprint}" != "${expected_fingerprint}" ]]; then
  echo "Refusing connection: unexpected CRS804 SSH host-key fingerprint" >&2
  echo "Expected: ${expected_fingerprint}" >&2
  echo "Received: ${actual_fingerprint:-none}" >&2
  exit 1
fi

export SSHPASS
IFS= read -r SSHPASS < <(pass show "${pass_entry}")
ssh_opts=(
  -o StrictHostKeyChecking=yes
  -o UserKnownHostsFile="${known_hosts}"
  -o ConnectTimeout=10
)

# scp splits host:path on the last colon, so an IPv6 literal -- such as the
# link-local used while the switch is still on its pre-move address -- has to
# be bracketed. ssh and ssh-keyscan take the bare form.
scp_host="${host}"
if [[ "${host}" == *:* ]]; then
  scp_host="[${host}]"
fi

"${sshpass_bin}" -e scp -O "${ssh_opts[@]}" "${config}" "${user}@${scp_host}:${remote_config}"

if [[ "${mode}" == "--dry-run" ]]; then
  "${sshpass_bin}" -e ssh -n "${ssh_opts[@]}" "${user}@${host}" \
    "/import file-name=${remote_config} verbose=yes dry-run"
else
  "${sshpass_bin}" -e ssh -n "${ssh_opts[@]}" "${user}@${host}" \
    "/export file=crs804-before-nixos-config"
  "${sshpass_bin}" -e ssh -n "${ssh_opts[@]}" "${user}@${host}" \
    "/import file-name=${remote_config} verbose=yes"
fi

unset SSHPASS
