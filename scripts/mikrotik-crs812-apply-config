#!/usr/bin/env bash
set -euo pipefail

host="${MIKROTIK_CRS812_HOST:-192.168.23.27}"
user="${MIKROTIK_CRS812_USER:-admin}"
expected_fingerprint="SHA256:pPltk09+zZ16G12cP7obyvENpKoL8UZuMdH2eDxdBGM"
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
config="${repo_root}/machines/routeros/crs812/config.rsc"
remote_config="crs812-nixos-config.rsc"

usage() {
  cat <<'EOF'
Usage: scripts/mikrotik-crs812-apply-config [--dry-run|--apply]

Authenticates with an imported SSH key. Set MIKROTIK_CRS812_HOST or
MIKROTIK_CRS812_USER to override the defaults.
EOF
}

mode="${1:---dry-run}"
case "${mode}" in
  --dry-run|--apply) ;;
  -h|--help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

for command in ssh ssh-keyscan ssh-keygen scp; do
  if ! command -v "${command}" >/dev/null 2>&1; then
    echo "Missing required command: ${command}" >&2
    exit 1
  fi
done

if [[ ! -d "${repo_root}/.git" ]]; then
  echo "Expected a Git worktree at ${repo_root}" >&2
  exit 1
fi

known_hosts="$(mktemp --tmpdir="${repo_root}/.git" crs812-known-hosts.XXXXXX)"
trap 'rm -f -- "${known_hosts}"' EXIT
ssh-keyscan -T 5 "${host}" >"${known_hosts}" 2>/dev/null
actual_fingerprint="$(ssh-keygen -lf "${known_hosts}" -E sha256 | awk 'NR == 1 { print $2 }')"
if [[ "${actual_fingerprint}" != "${expected_fingerprint}" ]]; then
  echo "Refusing connection: unexpected CRS812 SSH host-key fingerprint" >&2
  echo "Expected: ${expected_fingerprint}" >&2
  echo "Received: ${actual_fingerprint:-none}" >&2
  exit 1
fi

ssh_opts=(
  -o BatchMode=yes
  -o StrictHostKeyChecking=yes
  -o UserKnownHostsFile="${known_hosts}"
  -o ConnectTimeout=10
)

scp -O "${ssh_opts[@]}" "${config}" "${user}@${host}:${remote_config}"

if [[ "${mode}" == "--dry-run" ]]; then
  ssh -n "${ssh_opts[@]}" "${user}@${host}" \
    "/import file-name=${remote_config} verbose=yes dry-run"
else
  ssh -n "${ssh_opts[@]}" "${user}@${host}" \
    "/export file=crs812-before-nixos-config"
  ssh -n "${ssh_opts[@]}" "${user}@${host}" \
    "/import file-name=${remote_config} verbose=yes"
fi
