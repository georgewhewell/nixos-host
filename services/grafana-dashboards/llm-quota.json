          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "scope": true
            },
            "renameByName": {
              "llm_quota_utilization_ratio": "used",
              "Value #A": "used",
              "Value": "resets in",
              "Value #B": "resets in"
            },
            "indexByName": {
              "provider": 0,
              "window": 1,
              "used": 2,
              "resets in": 3
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
