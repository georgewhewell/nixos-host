{
  "uid": "llm-quota",
  "title": "LLM Subscription Quotas",
  "tags": [
    "llm",
    "quota"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "bargauge",
      "title": "Utilization now",
      "description": "Fraction of each quota window consumed. 1.0 = limit reached.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "feit1tygbp81sc"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc(llm_quota_utilization_ratio{scope=\"all\"})",
          "instant": true,
          "legendFormat": "{{provider}} \u00b7 {{window}}"
        },
        {
          "refId": "B",
          "expr": "llm_quota_utilization_ratio{provider=\"gemini\",window=\"bucket\"}",
          "instant": true,
          "legendFormat": "gemini \u00b7 {{scope}}"
        }
      ],
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "top"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#eda100",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Window resets in",
      "description": "Time until each quota window resets.",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "feit1tygbp81sc"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min(llm_quota_reset_timestamp_seconds{scope=\"all\"} - time(), 0)",
          "instant": true,
          "legendFormat": "{{provider}} \u00b7 {{window}}"
        }
      ],
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Plans",
      "gridPos": {
        "h": 9,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "feit1tygbp81sc"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llm_provider_info",
          "instant": true
        }
      ],
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "indexByName": {
              "provider": 0,
              "plan": 1,
              "tier": 2
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Session window (5h)",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "feit1tygbp81sc"
      },
      "interval": "5m",
      "targets": [
        {
          "refId": "A",
          "expr": "llm_quota_utilization_ratio{window=\"five_hour\",scope=\"all\"}",
          "legendFormat": "{{provider}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "pointSize": 4,
            "showPoints": "auto",
            "spanNulls": 3600000
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "anthropic"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "gemini"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "grok"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "kimi"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#c98500"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "openai"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d55181"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Weekly / monthly windows",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "feit1tygbp81sc"
      },
      "interval": "5m",
      "targets": [
        {
          "refId": "A",
          "expr": "llm_quota_utilization_ratio{window=~\"seven_day|monthly\",scope=\"all\"}",
          "legendFormat": "{{provider}} \u00b7 {{window}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "spanNulls": 3600000,
            "pointSize": 4
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "anthropic.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "gemini.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "grok.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "kimi.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#c98500"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "openai.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d55181"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*monthly"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    10,
                    6
                  ],
                  "fill": "dash"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Model-scoped windows",
      "description": "Per-model weekly caps (Anthropic) and per-model buckets (Gemini).",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "feit1tygbp81sc"
      },
      "interval": "5m",
      "targets": [
        {
          "refId": "A",
          "expr": "llm_quota_utilization_ratio{scope!=\"all\"}",
          "legendFormat": "{{provider}} \u00b7 {{scope}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "spanNulls": 3600000,
            "pointSize": 4
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "anthropic.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "gemini.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "grok.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "kimi.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#c98500"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "openai.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d55181"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "stat",
      "title": "Exporter health",
      "description": "1 = last poll of this provider succeeded.",
      "gridPos": {
        "h": 9,
        "w": 6,
        "x": 12,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "feit1tygbp81sc"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llm_quota_scrape_success",
          "instant": true,
          "legendFormat": "{{provider}}"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "\u2717 failing",
                  "color": "red"
                },
                "1": {
                  "text": "\u2713 ok",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Data age",
      "description": "Time since the last successful poll per provider.",
      "gridPos": {
        "h": 9,
        "w": 6,
        "x": 18,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "feit1tygbp81sc"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - llm_quota_last_success_timestamp_seconds",
          "instant": true,
          "legendFormat": "{{provider}}"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#eda100",
                "value": 900
              },
              {
                "color": "red",
                "value": 3600
              }
            ]
          }
        },
        "overrides": []
      }
    }
  ]
}
