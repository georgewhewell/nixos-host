{
  "uid": "bluefield-vpp",
  "title": "BlueField2 VPP WAN router",
  "tags": ["bluefield2", "vpp", "wan"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {"from": "now-6h", "to": "now"},
  "refresh": "15s",
  "panels": [
    {"id": 1, "type": "timeseries", "title": "WAN throughput (bf0.100)", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "feit1tygbp81sc"}, "targets": [{"refId": "A", "expr": "8 * rate(vpp_interface_rx_bytes_total{interface=\"bf0.100\"}[5m])", "legendFormat": "WAN RX"}, {"refId": "B", "expr": "8 * rate(vpp_interface_tx_bytes_total{interface=\"bf0.100\"}[5m])", "legendFormat": "WAN TX"}], "fieldConfig": {"defaults": {"unit": "bps", "decimals": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 2, "type": "timeseries", "title": "WiFi packet rate (bf0.50)", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "feit1tygbp81sc"}, "targets": [{"refId": "A", "expr": "rate(vpp_interface_rx_packets_total{interface=\"bf0.50\"}[5m])", "legendFormat": "WiFi RX pps"}, {"refId": "B", "expr": "rate(vpp_interface_tx_packets_total{interface=\"bf0.50\"}[5m])", "legendFormat": "WiFi TX pps"}], "fieldConfig": {"defaults": {"unit": "pps", "decimals": 0}, "overrides": []}},
    {"id": 12, "type": "timeseries", "title": "Untagged LAN/fabric pps (bf0 minus VLANs)", "gridPos": {"x": 0, "y": 40, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "feit1tygbp81sc"}, "targets": [{"refId": "A", "expr": "clamp_min(rate(vpp_interface_rx_packets_total{interface=\"bf0\"}[5m]) - sum(rate(vpp_interface_rx_packets_total{interface=~\"bf0\\..*\"}[5m])), 0)", "legendFormat": "LAN/fabric RX pps"}, {"refId": "B", "expr": "clamp_min(rate(vpp_interface_tx_packets_total{interface=\"bf0\"}[5m]) - sum(rate(vpp_interface_tx_packets_total{interface=~\"bf0\\..*\"}[5m])), 0)", "legendFormat": "LAN/fabric TX pps"}], "fieldConfig": {"defaults": {"unit": "pps", "decimals": 0}, "overrides": []}},
    {"id": 13, "type": "timeseries", "title": "Untagged LAN/fabric bit/s (bf0 minus VLANs)", "gridPos": {"x": 12, "y": 40, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "feit1tygbp81sc"}, "targets": [{"refId": "A", "expr": "8 * clamp_min(rate(vpp_interface_rx_bytes_total{interface=\"bf0\"}[5m]) - sum(rate(vpp_interface_rx_bytes_total{interface=~\"bf0\\..*\"}[5m])), 0)", "legendFormat": "LAN/fabric RX bit/s"}, {"refId": "B", "expr": "8 * clamp_min(rate(vpp_interface_tx_bytes_total{interface=\"bf0\"}[5m]) - sum(rate(vpp_interface_tx_bytes_total{interface=~\"bf0\\..*\"}[5m])), 0)", "legendFormat": "LAN/fabric TX bit/s"}], "fieldConfig": {"defaults": {"unit": "bps", "decimals": 0}, "overrides": []}},
    {"id": 3, "type": "timeseries", "title": "Interface drops and drop ratio", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "feit1tygbp81sc"}, "targets": [{"refId": "A", "expr": "rate(vpp_interface_drops_packets_total{interface=~\"bf0\\..*\"}[5m])", "legendFormat": "{{interface}} drops/s"}, {"refId": "B", "expr": "100 * sum by (interface) (rate(vpp_interface_drops_packets_total{interface=~\"bf0\\..*\"}[5m])) / clamp_min(sum by (interface) (rate(vpp_interface_rx_packets_total{interface=~\"bf0\\..*\"}[5m])), 1)", "legendFormat": "{{interface}} drop %"}], "fieldConfig": {"defaults": {"unit": "pps"}, "overrides": [{"matcher": {"id": "byName", "options": "bf0.100 drop %"}, "properties": [{"id": "unit", "value": "percent"}]}]}},
    {"id": 4, "type": "stat", "title": "NAT sessions / total capacity", "description": "Sessions and six-worker total capacity. Use the utilisation panel for 70%/90% thresholds.", "gridPos": {"x": 12, "y": 8, "w": 6, "h": 8}, "datasource": {"type": "prometheus", "uid": "feit1tygbp81sc"}, "targets": [{"refId": "A", "expr": "vpp_nat44_ed_sessions", "legendFormat": "sessions"}, {"refId": "B", "expr": "vpp_nat44_ed_max_configured_sessions", "legendFormat": "capacity"}], "fieldConfig": {"defaults": {"unit": "short"}}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": true, "fields": ""}, "textMode": "value_and_name"}},
    {"id": 5, "type": "timeseries", "title": "NAT session utilisation", "gridPos": {"x": 18, "y": 8, "w": 6, "h": 8}, "datasource": {"type": "prometheus", "uid": "feit1tygbp81sc"}, "targets": [{"refId": "A", "expr": "100 * vpp_nat44_ed_sessions / clamp_min(vpp_nat44_ed_max_configured_sessions, 1)", "legendFormat": "sessions %"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 70}, {"color": "red", "value": 90}]}}}},
    {"id": 6, "type": "timeseries", "title": "VPP worker/vector rate", "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "feit1tygbp81sc"}, "targets": [{"refId": "A", "expr": "vpp_worker_vector_rate_per_worker", "legendFormat": "worker {{worker}}"}, {"refId": "B", "expr": "vpp_sys_vector_rate", "legendFormat": "aggregate"}], "fieldConfig": {"defaults": {"unit": "short"}}},
    {"id": 7, "type": "timeseries", "title": "VPP buffer pool", "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "feit1tygbp81sc"}, "targets": [{"refId": "A", "expr": "vpp_buffer_pools_default_numa_0_available", "legendFormat": "available"}, {"refId": "B", "expr": "vpp_buffer_pools_default_numa_0_used", "legendFormat": "used"}], "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 10000}, {"color": "green", "value": 25000}]}}}},
    {"id": 8, "type": "timeseries", "title": "NAT, ACL and uRPF errors", "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "feit1tygbp81sc"}, "targets": [{"refId": "A", "expr": "rate(vpp_error_packets_total{node=~\"nat44.*|acl-plugin-.*|ip[46].*urpf.*\"}[5m])", "legendFormat": "{{node}} {{error}}"}], "fieldConfig": {"defaults": {"unit": "pps"}}},
    {"id": 9, "type": "timeseries", "title": "BlueField CPU and memory", "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "feit1tygbp81sc"}, "targets": [{"refId": "A", "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{instance=\"bluefield2:9100\",mode=\"idle\"}[5m])) * 100)", "legendFormat": "CPU busy"}, {"refId": "B", "expr": "100 * (1 - node_memory_MemAvailable_bytes{instance=\"bluefield2:9100\"} / node_memory_MemTotal_bytes{instance=\"bluefield2:9100\"})", "legendFormat": "memory used"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}}},
    {"id": 10, "type": "timeseries", "title": "mlx5 steering misses", "gridPos": {"x": 0, "y": 32, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "feit1tygbp81sc"}, "targets": [{"refId": "A", "expr": "rate(vpp_mlx5_rx_steer_missed_packets_total[5m])", "legendFormat": "steer misses/s"}], "fieldConfig": {"defaults": {"unit": "pps", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 10}, {"color": "red", "value": 100}]}}}},
    {"id": 11, "type": "timeseries", "title": "NIC physical errors", "gridPos": {"x": 12, "y": 32, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "feit1tygbp81sc"}, "targets": [{"refId": "A", "expr": "vpp_mlx5_rx_crc_errors_phy_total", "legendFormat": "RX CRC"}, {"refId": "B", "expr": "vpp_mlx5_rx_out_of_buffer_total", "legendFormat": "RX out of buffer"}, {"refId": "C", "expr": "vpp_mlx5_tx_errors_phy_total", "legendFormat": "TX errors"}], "fieldConfig": {"defaults": {"unit": "short"}}}
  ]
}
